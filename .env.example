# Never commit your filled-in .env file.
DAYTONA_API_KEY=
# Optional overrides; SDK defaults otherwise
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us

# AuraDB connect string is usually neo4j+s://<instance>.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Nosana API keys normally begin with nos_
NOSANA_API_KEY=
# Optional: leave blank to discover a currently available model
NOSANA_MODEL=
